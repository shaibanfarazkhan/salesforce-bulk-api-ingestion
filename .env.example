# ==============================================================================
# SALESFORCE BULK API 2.0 DATA INGESTION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | testing | production)
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL 17 Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sf_ingest_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sf_ingest_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Salesforce Connected App OAuth 2.0 Credentials
CLIENT_ID=3MVG9...your_connected_app_client_id
CLIENT_SECRET=your_connected_app_client_secret
LOGIN_URL=https://login.salesforce.com
SF_USERNAME=integration.user@enterprise.com
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_salesforce_security_token
SF_API_VERSION=v62.0

# Ingestion & Polling Parameters
CHUNK_SIZE=10000
POLL_MAX_ATTEMPTS=120
LOG_LEVEL=INFO
